chanly.ru {
    encode zstd gzip
    handle /api/landing/contact {
        reverse_proxy chanly-landing-contact-production:8091 {
            header_up -Authorization
            header_up X-Real-IP {remote_host}
        }
    }
    handle /landing-assets/* {
        root * /srv/maxim-production/landing/shared
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    @legal path /offer /offer-author /rules /privacy_policy /consent-feedback /requisites
    handle @legal {
        root * /srv/maxim-production/landing/current
        rewrite * {path}.pdf
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        header Content-Disposition "inline"
        file_server
    }
    @legal_pdf path /offer.pdf /offer-author.pdf /rules.pdf /privacy_policy.pdf /consent-feedback.pdf /requisites.pdf
    handle @legal_pdf {
        root * /srv/maxim-production/landing/current
        header Cache-Control "no-cache"
        header X-Content-Type-Options "nosniff"
        header Content-Disposition "inline"
        file_server
    }

    @landing {
        path /
        file {
            root /srv/maxim-production/landing/current
            try_files /index.html
        }
    }
    handle @landing {
        root * /srv/maxim-production/landing/current
        header Cache-Control "no-cache"
        rewrite * /index.html
        file_server
    }
    handle {
        header Retry-After "3600"
        respond "Service unavailable: application setup in progress" 503
    }
}
